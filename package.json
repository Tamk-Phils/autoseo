{
  "name": "ai-seo-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma db push --skip-generate || true) && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npx tsc tests/acquisition.test.ts --outDir /tmp/autoseo-test --module commonjs --target es2022 --moduleResolution node --esModuleInterop --skipLibCheck && node --test /tmp/autoseo-test/tests/acquisition.test.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.0.0",
    "lucide-react": "^0.475.0",
    "neon": "^8.0.11",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  }
}
